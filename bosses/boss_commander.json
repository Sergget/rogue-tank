      "weakspots": ["commander"],
      "ai": { "mode": "hold", "params": { "anchorRange": 300 } },
      "onEnter": {
        "modifiers": [
          { "stat": "armor.hull", "mode": "add", "value": 60 },
          { "stat": "armor.turret", "mode": "add", "value": 50 },
          { "stat": "reload", "mode": "mult", "value": 1.3 },
          { "stat": "turretTurnRate", "mode": "mult", "value": 0.9 }
        ]
      }
    },
    {
      "id": "p2_breach",
      "name": "护盾破裂",
      "hpFrom": 0.66,
      "hpTo": 0.33,
      "behavior": "护盾发生器被毁：能量屏障移除（阶段 1 的 +60/+50 消失，装甲回基础），主装甲直接暴露；指挥官指挥残余护卫合围玩家，本体摆角防御并加速机动（极速 ×1.15）——弱点是炮塔指挥塔（weakspot commander）与弹药架（weakspot ammo），命中指挥官可干扰其指挥；优先拉开与护卫的距离，集火本体。",
      "weakspots": ["commander", "ammo"],
      "ai": { "mode": "skirmish", "params": { "keepDist": 500 } },
      "onEnter": {
        "modifiers": [
          { "stat": "reload", "mode": "mult", "value": 0.85 },
          { "stat": "turretTurnRate", "mode": "mult", "value": 1.1 },
          { "stat": "maxSpeed", "mode": "mult", "value": 1.15 }
        ]
      }
    },
    {
      "id": "p3_last",
      "name": "孤注一掷",
