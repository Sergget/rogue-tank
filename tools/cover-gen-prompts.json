{
  "_note": "地图元素出图索引：key → 提示词条目编号 + 出图分辨率。**尺寸与锚点不在这里**——单一来源是 tools/cover-refs.json（由 node tools/dump-cover-refs.mjs 从 js/tank_assets.js 的烘焙代码导出），出图宽高比也从那里派生。改 prompt 只改 tools/cover-gen-prompts.md。",
  "version": 2,
  "assets": [
    { "key": "soft",          "prompt": "P1",  "generateLongest": 1024, "note": "细长条：按最终画布宽高比出图，模型可能画得偏方，后期按内容包围盒裁" },
    { "key": "barricade",     "prompt": "P2",  "generateLongest": 1024 },
    { "key": "stump",         "prompt": "P3",  "generateLongest": 1024 },
    { "key": "rubble",        "prompt": "P4",  "generateLongest": 1024 },
    { "key": "bush",          "prompt": "P5",  "generateLongest": 1024, "optional": true, "note": "几乎纯阴影椭圆，建议跳过出图沿用程序化 bake" },
    { "key": "bush_canopy",   "prompt": "P6",  "generateLongest": 1024 },
    { "key": "tree",          "prompt": "P7",  "generateLongest": 1024 },
    { "key": "tree_canopy",   "prompt": "P8",  "generateLongest": 1024 },
    { "key": "fallen",        "prompt": "P9",  "generateLongest": 1024 },
    { "key": "fallen_canopy", "prompt": "P10", "generateLongest": 1024 }
  ],
  "providers": {
    "gemini":    { "envKeys": ["GEMINI_API_KEY", "COVER_API_KEY"], "defaultModel": "gemini-2.5-flash-image" },
    "replicate": { "envKeys": ["REPLICATE_API_TOKEN", "COVER_API_KEY"], "defaultModel": "black-forest-labs/flux-schnell" },
    "openai":    { "envKeys": ["OPENAI_API_KEY", "COVER_API_KEY"], "defaultModel": "gpt-image-1" },
    "mock":      { "envKeys": [], "defaultModel": "procedural" }
  }
}
